<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool: generates src/Contracts/Generated from contracts/schemas (ADR-0007). Not shipped.
       It links the schema adapter source instead of referencing src/Contracts, so it still builds
       when the generated files are broken or missing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GlassWorld.Tools.ContractGen</RootNamespace>
    <AssemblyName>GlassWorld.Tools.ContractGen</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NJsonSchema.CodeGeneration.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Contracts\Validation\SchemaBundle.cs" Link="SchemaBundle.cs" />
  </ItemGroup>
</Project>
