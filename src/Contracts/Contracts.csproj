<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# types for the messages between core and AI service. Generated from contracts/schemas;
       do not edit Generated/*.g.cs by hand (run tools/ContractGen). No Godot, no NJsonSchema at runtime. -->
  <PropertyGroup>
    <RootNamespace>GlassWorld.Contracts</RootNamespace>
    <AssemblyName>GlassWorld.Contracts</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Generated code carries its own XML docs where the schema has descriptions. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
