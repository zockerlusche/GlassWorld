<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless runner: advances a world without Godot as fast as possible (tests, long runs, R14), with
       the mock or the live AI service (D9 tooling), and replays save games from seed and logs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GlassWorld.Simulation.Headless</RootNamespace>
    <AssemblyName>GlassWorld.Simulation.Headless</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiClient\AiClient.csproj" />
    <ProjectReference Include="..\Simulation.Core\Simulation.Core.csproj" />
    <ProjectReference Include="..\Simulation.Data\Simulation.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GlassWorld.Simulation.Headless.Tests" />
  </ItemGroup>
</Project>
