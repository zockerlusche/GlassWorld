<Project Sdk="Microsoft.NET.Sdk">
  <!-- HTTP connection from the game to the local AI service (ADR-0006). Implements the core's decider port;
       the core itself has no IO. -->
  <PropertyGroup>
    <RootNamespace>GlassWorld.AiClient</RootNamespace>
    <AssemblyName>GlassWorld.AiClient</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport (Job Object) generates marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Simulation.Core\Simulation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests replace the poll delay to check the backoff without the wall clock. -->
    <InternalsVisibleTo Include="GlassWorld.AiClient.Tests" />
  </ItemGroup>
</Project>
