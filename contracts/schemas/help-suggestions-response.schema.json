{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/help-suggestions-response.schema.json",
  "title": "HelpSuggestionsResponse",
  "description": "2-3 proposed helps. A gift names an allowed object type and amount; an answer is a calm sentence the player may send (it then goes through the conversation flow). The core drops every suggestion it does not allow; the player chooses or ignores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "tick",
    "suggestions",
    "rationale",
    "meta"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/RequestId"
    },
    "tick": {
      "description": "Echo of the request tick; the core discards stale responses.",
      "$ref": "common.schema.json#/$defs/Tick"
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/HelpSuggestion"
      }
    },
    "rationale": {
      "description": "Short English reasoning for logs. Never shown to the player.",
      "type": "string",
      "maxLength": 280
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/ResponseMeta"
    }
  },
  "$defs": {
    "HelpSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "gift",
        "reason"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gift",
            "answer"
          ]
        },
        "gift": {
          "description": "Set only for kind gift.",
          "anyOf": [
            {
              "$ref": "#/$defs/GiftProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "description": "Why this helps, shown on the suggestion card (for an answer: the sentence itself).",
          "$ref": "common.schema.json#/$defs/GeneratedText"
        }
      }
    },
    "GiftProposal": {
      "description": "A gift the player may place anywhere the core allows; it belongs to nobody once it lands (F5238).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "amount"
      ],
      "properties": {
        "type_id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
