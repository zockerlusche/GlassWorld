{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/placeholder-start.schema.json",
  "title": "PlaceholderStart",
  "description": "Data file content/world/placeholder-start.json: a flat placeholder start world for B1 (headless runs, smoke test) until B2 generates the island from the seed. Group centres, how far members of a group start apart, and objects scattered around each group (positions from the world seed). Placeholders only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "groups", "member_spread_m", "objects"],
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "groups": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/GroupCentre" } },
    "member_spread_m": { "type": "number", "minimum": 0, "maximum": 1000 },
    "objects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/ObjectPlacement" } }
  },
  "$defs": {
    "GroupCentre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "x", "z"],
      "properties": {
        "group": { "type": "integer", "minimum": 1, "maximum": 8 },
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "z": { "type": "number", "minimum": -100000, "maximum": 100000 }
      }
    },
    "ObjectPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count_per_group", "radius_m"],
      "properties": {
        "type": { "$ref": "common.schema.json#/$defs/VocabId" },
        "count_per_group": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "radius_m": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
