{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/decision-request.schema.json",
  "title": "DecisionRequest",
  "description": "Core -> AI service: one inhabitant asks the decider which of the offered options to take.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "tick",
    "seed",
    "deadline_ms",
    "display_locale",
    "inhabitant",
    "environment",
    "perception",
    "options"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/RequestId"
    },
    "tick": {
      "$ref": "common.schema.json#/$defs/Tick"
    },
    "seed": {
      "description": "Sampling seed derived by the core from world seed and tick (determinism).",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "deadline_ms": {
      "description": "Wall-clock budget for the AI service. When exceeded the service returns ServiceError 'timeout' and never makes a substitute decision; the core decides at a fixed tick and logs the outcome for replay.",
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "display_locale": {
      "$ref": "common.schema.json#/$defs/Locale"
    },
    "inhabitant": {
      "$ref": "common.schema.json#/$defs/InhabitantState"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentState"
    },
    "perception": {
      "$ref": "#/$defs/Perception"
    },
    "options": {
      "description": "Actions the core currently allows. The decider must pick exactly one of them.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/Option"
      }
    }
  },
  "$defs": {
    "PerceivedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "distance_m",
        "known_properties"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "known_properties": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/KnownProperty"
          }
        }
      }
    },
    "Perception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "inhabitants"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/PerceivedObject"
          }
        },
        "inhabitants": {
          "description": "Other inhabitants in sight, nearest first.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/PerceivedInhabitant"
          }
        }
      }
    },
    "Option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "action",
        "target",
        "partners"
      ],
      "properties": {
        "option_id": {
          "$ref": "common.schema.json#/$defs/OptionId"
        },
        "action": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "target": {
          "description": "Target instance, or null for actions without target.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "partners": {
          "description": "Further objects used together with target (e.g. combine flint with pyrite), sorted by id; empty for actions with one object or none.",
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/EntityId"
          }
        }
      }
    },
    "EnvironmentState": {
      "description": "What the inhabitant can sense right now. Deliberately no season name: inhabitants must learn that seasons exist and return (concept). A season concept reaches the model only through the inhabitant's own knowledge.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_of_day",
        "temperature_c",
        "weather"
      ],
      "properties": {
        "time_of_day": {
          "description": "Vocabulary kind time_of_day (dawn, day, dusk, night).",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "temperature_c": {
          "description": "Felt temperature of the inhabitant in degrees Celsius: air temperature plus wind, wetness, sun or shade, reduced by protection (clothing, hut, cave, fire, body warmth of others). The need warmth is derived from it by the core. Rounded to 1 decimal.",
          "type": "number",
          "minimum": -60,
          "maximum": 60
        },
        "weather": {
          "description": "All current weather conditions (vocabulary kind weather), e.g. rain and storm together. Sorted by id by the core.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        }
      }
    },
    "PerceivedInhabitant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "distance_m"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "visible_conditions": {
          "description": "Conditions others can SEE (limping, lying down, pale; which ones is core data), never the cause (B2543). Optional until the core sends it.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        }
      }
    }
  }
}
