{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-quality.schema.json",
  "title": "LookQuality",
  "description": "Data file content/look/quality.json: quality levels (B2 R30). Which level a hardware tier uses is decided in B7. Values are placeholders until the benchmark (acceptance 5) has measured them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "default_level",
    "levels"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "default_level": {
      "$ref": "common.schema.json#/$defs/VocabId"
    },
    "levels": {
      "description": "Levels from lowest to highest.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/QualityLevel"
      },
      "maxItems": 8
    }
  },
  "$defs": {
    "QualityLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "grass_density",
        "grass_distance_m",
        "shadows",
        "outline"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "grass_density": {
          "description": "Grass instances relative to the full density (0..1).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grass_distance_m": {
          "description": "Distance up to which grass is drawn.",
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "shadows": {
          "description": "Shadow quality.",
          "type": "string",
          "enum": [
            "off",
            "low",
            "high"
          ]
        },
        "outline": {
          "description": "Outline method of the comic style.",
          "type": "string",
          "enum": [
            "off",
            "inverted_hull",
            "post_process"
          ]
        }
      }
    }
  }
}
