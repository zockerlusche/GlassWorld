{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-epochs.schema.json",
  "title": "LookEpochs",
  "description": "Data file content/look/epochs.json: look epochs (B2514 T5). An epoch changes only palette and details, never models or shaders (B2501), and is blended softly. The core checks an epoch command against these ids and the reached tech level (R16; trigger B4b).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "blend_real_seconds",
    "epochs"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "blend_real_seconds": {
      "description": "How long an epoch change blends.",
      "type": "number",
      "minimum": 0,
      "maximum": 600
    },
    "epochs": {
      "description": "Epochs in their order (vocabulary kind epoch).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/LookEpoch"
      },
      "maxItems": 32
    }
  },
  "$defs": {
    "LookEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tech_level",
        "colors",
        "details"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "tech_level": {
          "description": "Tech level the world must have reached for this epoch (B4b).",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "colors": {
          "description": "Overrides of base colours (content/look/palette.json).",
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/LookColor"
          },
          "maxItems": 64
        },
        "details": {
          "description": "Detail switches the presentation turns on (e.g. paths, smoke).",
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    },
    "LookColor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "color"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "color": {
          "description": "Colour as lowercase #rrggbb.",
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    }
  }
}
