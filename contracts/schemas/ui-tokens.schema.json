{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/ui-tokens.schema.json",
  "title": "UiTokens",
  "description": "Design tokens of the UI standard D366 (KR6): sizes in logical pixels at the base resolution and 100 %, colours per palette, timings. The game builds its theme from this file; no UI value lives in code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "base_width",
    "base_height",
    "ui_scale",
    "text_scale",
    "min_font_px",
    "font_sizes",
    "spacing",
    "window",
    "button",
    "table",
    "toast",
    "durations_ms",
    "palettes",
    "knock",
    "head_symbol",
    "zones"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "base_width": {
      "description": "Logical width the layout is designed for.",
      "type": "integer",
      "minimum": 320,
      "maximum": 7680
    },
    "base_height": {
      "description": "Logical height the layout is designed for.",
      "type": "integer",
      "minimum": 240,
      "maximum": 4320
    },
    "ui_scale": {
      "description": "UI size setting (B2513: 75-200 %).",
      "$ref": "#/$defs/UiScaleRange"
    },
    "text_scale": {
      "description": "Separate text size setting (XAG 101: up to 200 %).",
      "$ref": "#/$defs/UiScaleRange"
    },
    "min_font_px": {
      "description": "Smallest font size at 100 % (XAG 101 for PC: 18).",
      "type": "integer",
      "minimum": 8,
      "maximum": 64
    },
    "font_sizes": {
      "description": "Font size steps.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/UiFontSize"
      }
    },
    "spacing": {
      "description": "Allowed spacing values on the 4 px grid.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/UiSpacing"
      }
    },
    "window": {
      "$ref": "#/$defs/UiWindowTokens"
    },
    "button": {
      "$ref": "#/$defs/UiButtonTokens"
    },
    "table": {
      "$ref": "#/$defs/UiTableTokens"
    },
    "toast": {
      "$ref": "#/$defs/UiToastTokens"
    },
    "durations_ms": {
      "description": "Animation timings; 'reduce motion' sets them all to 0.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/UiDuration"
      }
    },
    "palettes": {
      "description": "Colour sets; 'default' is required, 'high_contrast' must reach 7:1 for text (XAG 102).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/UiPalette"
      }
    },
    "knock": {
      "$ref": "#/$defs/UiKnock"
    },
    "head_symbol": {
      "description": "Symbols above inhabitants' heads (question marks, feeling symbols; F5284): one common world size, and on screen never smaller or larger than the given pixel heights, so they are readable at every zoom.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_m",
        "min_px",
        "max_px"
      ],
      "properties": {
        "size_m": {
          "description": "Height of a question mark in the world (metres); feeling symbols keep their own size_m of the same order.",
          "type": "number",
          "minimum": 0.05,
          "maximum": 3
        },
        "min_px": {
          "description": "Smallest height on screen (pixels at the reference height, scaled with the UI).",
          "type": "number",
          "minimum": 4,
          "maximum": 400
        },
        "max_px": {
          "description": "Largest height on screen (pixels at the reference height, scaled with the UI).",
          "type": "number",
          "minimum": 4,
          "maximum": 800
        }
      }
    },
    "zones": {
      "description": "Sizes of the zones layout (UI concept W1717, D642; preview behind a player setting): compact so the middle of the picture stays free.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side_panel_width",
        "log_width",
        "log_height_share",
        "panel_padding"
      ],
      "properties": {
        "side_panel_width": {
          "description": "Width of the side window on the right (pixels at the reference size; grows with the text size).",
          "type": "integer",
          "minimum": 200,
          "maximum": 1200
        },
        "log_width": {
          "description": "Width of the pinned log on the left.",
          "type": "integer",
          "minimum": 160,
          "maximum": 1200
        },
        "log_height_share": {
          "description": "Share of the free height below the top bar the log takes.",
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "panel_padding": {
          "description": "Inner padding of the top bar and the zone panels (the windows of the layout so far keep window.padding).",
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    }
  },
  "$defs": {
    "UiScaleRange": {
      "description": "A player-adjustable factor (1 = 100 %).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "step",
        "default"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "max": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "step": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "default": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        }
      }
    },
    "UiWindowTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "padding",
        "gap",
        "section_gap",
        "corner_radius",
        "border_width",
        "safe_margin",
        "max_screen_fraction",
        "side_panel_width",
        "bubble_max_chars",
        "list_refresh_ms",
        "pick_radius_px",
        "table_min_height",
        "card_bar_width",
        "mark_height_m",
        "mark_font_px",
        "settings_apply_ms",
        "modal_dim",
        "log_lines",
        "questions_shown",
        "diary_lines",
        "field_min_width",
        "settings_label_width"
      ],
      "properties": {
        "settings_apply_ms": {
          "description": "Pause after the last change of a size slider (keyboard, controller) before it takes effect.",
          "type": "integer",
          "minimum": 50,
          "maximum": 3000
        },
        "table_min_height": {
          "description": "Smallest height of a table in a side panel.",
          "type": "integer",
          "minimum": 80,
          "maximum": 2000
        },
        "card_bar_width": {
          "description": "Width of the value bars on the inhabitant card.",
          "type": "integer",
          "minimum": 40,
          "maximum": 1000
        },
        "mark_height_m": {
          "description": "Height of the question mark above an inhabitant's feet (metres, world space).",
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        },
        "mark_font_px": {
          "description": "Font size of the question mark in world space.",
          "type": "integer",
          "minimum": 16,
          "maximum": 400
        },
        "list_refresh_ms": {
          "description": "Lists (inhabitants, open questions) are rebuilt at most this often, also in fast-forward.",
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "pick_radius_px": {
          "description": "Clicking within this distance (logical px) of a figure selects it.",
          "type": "integer",
          "minimum": 8,
          "maximum": 200
        },
        "side_panel_width": {
          "description": "Width of a docked side panel (mailbox, inhabitants, chronicle, open questions).",
          "type": "integer",
          "minimum": 200,
          "maximum": 1200
        },
        "bubble_max_chars": {
          "description": "Line length of speech bubbles in characters (D366 section 3: about 60).",
          "type": "integer",
          "minimum": 20,
          "maximum": 120
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "section_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "corner_radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "border_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "safe_margin": {
          "description": "Distance to every screen edge.",
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "max_screen_fraction": {
          "description": "A window never covers more than this part of the screen.",
          "type": "number",
          "minimum": 0.3,
          "maximum": 1
        },
        "modal_dim": {
          "description": "Darkening of the game behind a modal window such as the pause menu (0 = none, 1 = black; W1687).",
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "log_lines": {
          "description": "Lines the conversation log keeps (W1696: who said or thought what), newest first.",
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "questions_shown": {
          "description": "Open questions the questions panel shows at once (newest first; W1696), so 100 inhabitants stay smooth.",
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "diary_lines": {
          "description": "Lines the diary of one inhabitant keeps (what it did, newest first; W1726).",
          "type": "integer",
          "minimum": 5,
          "maximum": 1000
        },
        "field_min_width": {
          "description": "Least width of a text field in a form (new world, settings), so its hint text is not cut off.",
          "type": "integer",
          "minimum": 80,
          "maximum": 800
        },
        "settings_label_width": {
          "description": "Least width of the label column in the settings, so a long word does not break inside.",
          "type": "integer",
          "minimum": 80,
          "maximum": 800
        }
      }
    },
    "UiButtonTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "compact_height",
        "min_hit",
        "hover_tint",
        "pressed_tint",
        "disabled_tint"
      ],
      "properties": {
        "height": {
          "description": "Height of a framed button; must hold the vertical frame margins.",
          "type": "integer",
          "minimum": 16,
          "maximum": 200
        },
        "compact_height": {
          "description": "Flat buttons in tables and bars.",
          "type": "integer",
          "minimum": 16,
          "maximum": 200
        },
        "min_hit": {
          "type": "integer",
          "minimum": 16,
          "maximum": 200
        },
        "hover_tint": {
          "description": "How strongly the accent colour tints a hovered frame (0 = not, 1 = fully).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pressed_tint": {
          "description": "Tint strength with the focus colour while pressed.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disabled_tint": {
          "description": "Tint strength with the muted text colour when disabled (plus a symbol, XAG 103).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "UiTableTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_height"
      ],
      "properties": {
        "row_height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 200
        }
      }
    },
    "UiToastTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_visible",
        "min_seconds",
        "bundle_after_waiting",
        "max_duration_factor"
      ],
      "properties": {
        "max_visible": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "min_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "bundle_after_waiting": {
          "description": "From this many waiting hints on, hints of one group are bundled at normal speed too (no endless backlog with many inhabitants).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_duration_factor": {
          "description": "Players can stretch the display time up to this factor (XAG 116: 10).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "UiFontSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "px"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "display",
            "header",
            "subheader",
            "body",
            "small"
          ]
        },
        "px": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128
        }
      }
    },
    "UiSpacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "px"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "UiDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ms"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "UiPalette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "colors"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/UiColor"
          }
        }
      }
    },
    "UiColor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rgba"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "background",
            "panel",
            "panel_strong",
            "border",
            "text",
            "text_muted",
            "accent",
            "focus",
            "positive",
            "attention",
            "bubble_inhabitant",
            "bubble_player"
          ]
        },
        "rgba": {
          "description": "Colour as #RRGGBB or #RRGGBBAA.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        }
      }
    },
    "UiKnock": {
      "description": "The knock at the glass and the mailbox urgency (A1341, review #86): ring sizes in px at the start and how much they grow, a small shake, and how warm the most urgent message gets. Calm values only (B2466).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer_px",
        "outer_grow_px",
        "inner_px",
        "inner_grow_px",
        "shakes",
        "shake_px",
        "urgency_tint"
      ],
      "properties": {
        "outer_px": {
          "description": "Outer ring radius at the start.",
          "type": "number",
          "minimum": 4,
          "maximum": 64
        },
        "outer_grow_px": {
          "description": "How much the outer ring grows.",
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "inner_px": {
          "description": "Inner ring radius at the start.",
          "type": "number",
          "minimum": 2,
          "maximum": 64
        },
        "inner_grow_px": {
          "description": "How much the inner ring grows.",
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "shakes": {
          "description": "Shakes during the tremor.",
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "shake_px": {
          "description": "Shake width.",
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "urgency_tint": {
          "description": "Share of the attention colour at the highest urgency (0 = no tint).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
