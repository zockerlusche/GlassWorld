{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/ollama-runtime.schema.json",
  "title": "OllamaRuntime",
  "description": "Which Ollama the game uses (B10 R3, F5266 = A): the version pinned in ADR-0001, loaded at first start from the official release after the player agreed, checked by SHA-256. An Ollama that already runs or is installed is used when its version is at least accept_from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "version",
    "accept_from",
    "licence",
    "source_page",
    "assets"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "version": {
      "description": "Version that is downloaded (ADR-0001).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "accept_from": {
      "description": "Lowest version of an existing Ollama that is used instead of a download.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "licence": {
      "description": "Licence shown in the download dialog.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_page": {
      "type": "string",
      "pattern": "^https://github\\.com/ollama/ollama/releases/tag/v[0-9.]+$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "url",
          "sha256",
          "size_bytes",
          "executable"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "windows-x86_64"
            ]
          },
          "url": {
            "description": "Official release download only.",
            "type": "string",
            "pattern": "^https://github\\.com/ollama/ollama/releases/download/v[0-9.]+/[A-Za-z0-9._-]+\\.zip$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "format": "int64"
          },
          "executable": {
            "description": "Path of the program inside the archive.",
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    "includes": {
      "description": "Other parts of the official archive, named in the download dialog (review GW1 #122).",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  }
}
