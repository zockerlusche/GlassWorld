{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/model-downloads.schema.json",
  "title": "ModelDownloads",
  "description": "Which AI models the game offers to download at first start (B10 R4), per hardware tier: name, licence, size, purpose and the official source with its checksum or digest. kind ollama: pulled through Ollama from its registry, digest checked. kind files: single files from an official source, SHA-256 checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "models"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "role",
          "tiers",
          "licence",
          "size_bytes",
          "source_page",
          "purpose_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ollama",
              "files"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "language",
              "image",
              "image_edit",
              "sound",
              "model3d"
            ]
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "minimum",
                "standard",
                "comfort"
              ]
            }
          },
          "licence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "format": "int64"
          },
          "source_page": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9./_:-]+$",
            "maxLength": 300
          },
          "purpose_key": {
            "description": "Text key (DE/EN, content/i18n) for the purpose shown in the dialog.",
            "type": "string",
            "pattern": "^ui\\.setup\\.model_[a-z0-9_]+$"
          },
          "ollama": {
            "description": "kind ollama: model name and the manifest digest (sha256, 64 hex).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._/-]*:[a-z0-9._-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "files": {
            "description": "kind files: each file with its official URL, SHA-256, size and place in the model folder.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "sha256",
                "size_bytes",
                "path"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://(huggingface\\.co|github\\.com)/[A-Za-z0-9./_%-]+$",
                  "maxLength": 400
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "format": "int64"
                },
                "path": {
                  "description": "Relative path below the model's folder; no '..'.",
                  "type": "string",
                  "pattern": "^(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_][A-Za-z0-9._/-]{0,199}$"
                }
              }
            }
          },
          "target": {
            "description": "kind files: store = our model folder (default); comfyui = the models folder of the player's own ComfyUI (B2514), path then relative to it (e.g. unet/...).",
            "type": "string",
            "enum": [
              "store",
              "comfyui"
            ]
          },
          "requires_nodes": {
            "description": "ComfyUI node classes the workflows of this model need (custom nodes the player has to install, e.g. UnetLoaderGGUF from ComfyUI-GGUF).",
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          }
        }
      }
    }
  }
}
