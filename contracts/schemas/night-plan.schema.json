{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/night-plan.schema.json",
  "title": "NightPlan",
  "description": "Data file content/hardware/night.json (B7 R3/R4): when each job kind may run and which model it needs, plus the night budget. Values from Marcel (B7 O2); placeholders until then.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "night_budget_s",
    "kinds"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "night_budget_s": {
      "description": "Real seconds the computing night may take (placeholder).",
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/KindPlan"
      }
    }
  },
  "$defs": {
    "KindPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "when",
        "model"
      ],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/JobKind"
        },
        "when": {
          "description": "any = as soon as the model is free (day or night); night = only in the computing night (standard tier; comfort runs it any time).",
          "type": "string",
          "enum": [
            "any",
            "night"
          ]
        },
        "model": {
          "description": "Model id of content/hardware/models.json the kind needs, or null (no model, e.g. stubs).",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
