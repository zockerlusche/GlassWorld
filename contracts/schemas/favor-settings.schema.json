{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/favor-settings.schema.json",
  "title": "FavorSettings",
  "description": "Favour energy of the player (B6 R9): how much there is, how it grows back and what interventions cost. All numbers are placeholders until Marcel decides (PR4, F5231).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "maximum",
    "start_options",
    "regrow_per_hour",
    "costs"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "maximum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "start_options": {
      "description": "Choices for 'start favour' in New World.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "regrow_per_hour": {
      "description": "Favour regained per game hour.",
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "costs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Cost"
      }
    }
  },
  "$defs": {
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention",
        "cost"
      ],
      "properties": {
        "intervention": {
          "description": "Intervention id, e.g. conversation, gift, weather.",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
