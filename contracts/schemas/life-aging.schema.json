{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/life-aging.schema.json",
  "title": "LifeAging",
  "description": "Data file content/life/aging.json (B9 R1, D1049 v2): how inhabitants age. Each has a tick of birth; its age in life years and its life phase follow from the clock and these values. Start inhabitants draw their age from start_age_years. Which actions a phase allows is data ('*' = all). All numbers are placeholders (B2649).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "days_per_life_year",
    "start_age_years",
    "phases"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "days_per_life_year": {
      "description": "Game days per life year.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3650
    },
    "start_age_years": {
      "description": "Age of the start inhabitants, drawn per inhabitant from its own stream.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "phases": {
      "description": "Life phases (vocabulary life_stage) from an age on; the first starts at 0.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/LifePhase"
      }
    }
  },
  "$defs": {
    "LifePhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_years",
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "from_years": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "actions": {
          "description": "Actions (vocabulary action) the decider may offer in this phase; '*' = all.",
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z][a-z0-9_]*)$",
            "maxLength": 64
          }
        }
      }
    }
  }
}
