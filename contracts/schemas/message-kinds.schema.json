{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/message-kinds.schema.json",
  "title": "MessageKinds",
  "description": "Kinds of mailbox messages and how unacknowledged ones are repeated (B6 R11). Display texts: msg.mail.kind.<id>. All numbers are placeholders until Marcel decides (PR4, F5231).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kinds"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/MessageKind"
      }
    }
  },
  "$defs": {
    "MessageKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "repeat_after_hours",
        "max_urgency"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "description": {
          "description": "Short English meaning, used in prompts and docs.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repeat_after_hours": {
          "description": "Game hours until an open message is repeated; 0 = never repeated.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max_urgency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
