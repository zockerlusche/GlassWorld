{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-carried.schema.json",
  "title": "LookCarried",
  "description": "A1785 (B2823, Marcel W2231/W2232): what an inhabitant carries sits visibly in its hands - never pushed along the ground, never in its growing pose. Per kind: grip, lie and height; the thing keeps its size in the world. The first kind whose types name the thing, or whose properties it all has, decides; else the default (lying across in front of the chest). Presentation only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "heights",
    "forward_m",
    "default",
    "kinds"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "heights": {
      "description": "Height of the hands above the feet for a figure of size 1, metres.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hip",
        "chest",
        "shoulder"
      ],
      "properties": {
        "hip": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2.5
        },
        "chest": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2.5
        },
        "shoulder": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2.5
        }
      }
    },
    "forward_m": {
      "description": "How far in front of the body the thing is held, metres for size 1.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "default": {
      "$ref": "#/$defs/CarryWay"
    },
    "kinds": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/CarriedKind"
      }
    }
  },
  "$defs": {
    "CarryWay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grip",
        "lie",
        "at"
      ],
      "properties": {
        "grip": {
          "description": "One hand (right) or both.",
          "type": "string",
          "enum": [
            "one",
            "two"
          ]
        },
        "lie": {
          "description": "across: lying crosswise in front of the body; slanted: tilted up over the shoulder; upright: standing up.",
          "type": "string",
          "enum": [
            "across",
            "slanted",
            "upright"
          ]
        },
        "at": {
          "description": "Height of the hands: hip, chest or shoulder (heights).",
          "type": "string",
          "enum": [
            "hip",
            "chest",
            "shoulder"
          ]
        }
      }
    },
    "CarriedKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "way"
      ],
      "properties": {
        "types": {
          "description": "Object types this kind is for.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "properties": {
          "description": "Or: every TRUE property here (e.g. stone: both hands, at the hip).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "way": {
          "$ref": "#/$defs/CarryWay"
        }
      }
    }
  }
}
