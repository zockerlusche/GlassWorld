{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-camera.schema.json",
  "title": "LookCamera",
  "description": "Data file content/look/camera.json: isometric overview camera with turning, zoom, panning and follow mode (B2 R26). The projection is a data value until Marcel's picture question T1 is answered (proposal: perspective with a narrow field of view). All moves are smooth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "projection",
    "fov_deg",
    "pitch_deg",
    "start_yaw_deg",
    "distance_m",
    "zoom_step",
    "rotate_deg_per_px",
    "pan_speed_m_s",
    "smoothing",
    "follow_distance_m",
    "bounds_margin_m",
    "pick_radius_m",
    "near_m",
    "far_m"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "projection": {
      "description": "perspective (narrow field of view, fixed iso pitch) or orthographic.",
      "type": "string",
      "enum": [
        "perspective",
        "orthographic"
      ]
    },
    "fov_deg": {
      "description": "Vertical field of view for perspective.",
      "type": "number",
      "minimum": 5,
      "maximum": 90
    },
    "pitch_deg": {
      "description": "Downward tilt of the camera.",
      "type": "number",
      "minimum": 10,
      "maximum": 89
    },
    "start_yaw_deg": {
      "description": "Turn at start.",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "distance_m": {
      "$ref": "#/$defs/CameraRange"
    },
    "zoom_step": {
      "description": "Share of the distance one zoom step changes.",
      "type": "number",
      "minimum": 0.01,
      "maximum": 0.9
    },
    "rotate_deg_per_px": {
      "description": "Turn per pixel of dragging.",
      "type": "number",
      "minimum": 0.01,
      "maximum": 5
    },
    "pan_speed_m_s": {
      "description": "Panning speed at the middle distance.",
      "type": "number",
      "minimum": 0.1,
      "maximum": 500
    },
    "smoothing": {
      "description": "Share of the remaining way per 1/60 s (0..1, higher is snappier).",
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "follow_distance_m": {
      "description": "Distance in follow mode.",
      "type": "number",
      "minimum": 1,
      "maximum": 500
    },
    "bounds_margin_m": {
      "description": "How far the view may leave the island.",
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "pick_radius_m": {
      "description": "How close (metres, on the ground) a click must land to a figure to pick it.",
      "type": "number",
      "minimum": 0.1,
      "maximum": 20
    },
    "near_m": {
      "description": "Near clipping distance of the camera.",
      "type": "number",
      "minimum": 0.01,
      "maximum": 10
    },
    "far_m": {
      "description": "Far clipping distance of the camera.",
      "type": "number",
      "minimum": 10,
      "maximum": 100000
    }
  },
  "$defs": {
    "CameraRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "start"
      ],
      "properties": {
        "min": {
          "description": "Nearest.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 5000
        },
        "max": {
          "description": "Farthest.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 5000
        },
        "start": {
          "description": "At start.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 5000
        }
      }
    }
  }
}
