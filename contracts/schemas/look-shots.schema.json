{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-shots.schema.json",
  "title": "LookShots",
  "description": "Data files content/look/shots*.json: shot sets of the screenshot tool (B2 R32). It renders every fixed camera point in every projection and day phase as PNG, and optionally in every listed epoch, season and weather. shots.json is the default set (the T1 pictures); further sets such as shots_dimensions.json are chosen with --shot-set. Presentation only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "points",
    "projections",
    "phases",
    "settle_frames"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ShotPoint"
      }
    },
    "projections": {
      "description": "Projections to render (picture question T1).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(perspective|orthographic)$"
      }
    },
    "phases": {
      "description": "Day phases from content/look/daylight.json.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      }
    },
    "settle_frames": {
      "description": "Frames to render before each picture (shaders, shadows).",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "epochs": {
      "description": "Optional: epochs from content/look/epochs.json; each picture then shows the palette of the epoch. Missing = the base palette, as before.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      }
    },
    "seasons": {
      "description": "Optional: seasons from content/world/time.json; each picture then shows the season palette of content/look/palette.json. Missing = the base palette, as before.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      }
    },
    "weather": {
      "description": "Optional: weather ids from content/vocabulary/weather.json. Weather without a look yet is rendered unchanged with a note in the file name.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      }
    }
  },
  "$defs": {
    "ShotPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_x_permille",
        "target_z_permille",
        "yaw_deg",
        "distance_m"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "target_x_permille": {
          "description": "Target across the map width, 0..1000.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "target_z_permille": {
          "description": "Target across the map depth, 0..1000.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "yaw_deg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "inhabitant": {
          "description": "Optional: look at the inhabitant with this index (ordered by id) instead of the map target.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
