{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-shots.schema.json",
  "title": "LookShots",
  "description": "Data file content/look/shots.json: the screenshot tool (B2 R32) renders every fixed camera point in every projection and day phase as PNG (weather, season and epoch follow with B2-5). Presentation only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "points",
    "projections",
    "phases",
    "settle_frames"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ShotPoint"
      }
    },
    "projections": {
      "description": "Projections to render (picture question T1).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(perspective|orthographic)$"
      }
    },
    "phases": {
      "description": "Day phases from content/look/daylight.json.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      }
    },
    "settle_frames": {
      "description": "Frames to render before each picture (shaders, shadows).",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "$defs": {
    "ShotPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_x_permille",
        "target_z_permille",
        "yaw_deg",
        "distance_m"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "target_x_permille": {
          "description": "Target across the map width, 0..1000.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "target_z_permille": {
          "description": "Target across the map depth, 0..1000.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "yaw_deg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "inhabitant": {
          "description": "Optional: look at the inhabitant with this index (ordered by id) instead of the map target.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
