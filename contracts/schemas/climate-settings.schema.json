{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/climate-settings.schema.json",
  "title": "ClimateSettings",
  "description": "Data file content/climate/<id>.json, weather part (B2 R13): weather states and their change per season. The weather changes at a fixed hour boundary by the transition table of the current season (stream weather/...). Snow replaces rain below the snow limit; drought follows from days without rain. The temperature part follows with B5 R1. All values are placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "weather"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/VocabId"
    },
    "weather": {
      "$ref": "#/$defs/ClimateWeather"
    }
  },
  "$defs": {
    "ClimateWeather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_every_hours",
        "transition_minutes",
        "snow_below_tenth_c",
        "drought_after_dry_days",
        "states",
        "seasons",
        "snow_weather",
        "drought_weather",
        "temperature",
        "gust_period_minutes"
      ],
      "properties": {
        "change_every_hours": {
          "description": "Game hours between two weather decisions.",
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "transition_minutes": {
          "description": "Game minutes the visual change takes (presentation and derived values).",
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "snow_below_tenth_c": {
          "description": "Below this temperature precipitation falls as snow (used once B5 adds temperatures).",
          "type": "integer",
          "minimum": -500,
          "maximum": 200
        },
        "drought_after_dry_days": {
          "description": "Days without rain after which drought is reported.",
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "states": {
          "description": "Values of every weather id (vocabulary kind weather).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ClimateWeatherState"
          },
          "maxItems": 32
        },
        "seasons": {
          "description": "Transition table per season (ids from content/world/time.json).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ClimateSeasonWeather"
          },
          "maxItems": 8
        },
        "snow_weather": {
          "description": "Weather id that precipitation becomes below snow_below_tenth_c.",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "drought_weather": {
          "description": "Weather id added to the conditions after drought_after_dry_days without precipitation (a signal for B5).",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "temperature": {
          "$ref": "#/$defs/ClimateTemperature"
        },
        "signals": {
          "description": "Optional: weather conditions whose start and end the core reports as world events (B2-5 R13, signals for B5). A condition is a weather id of the states; it counts as on while it is among the current conditions (the main weather, or the drought weather after the dry days). Missing = no signals.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClimateSignal"
          }
        },
        "gust_period_minutes": {
          "description": "Game minutes between two gust key values (GW3): the wind swings smoothly between values drawn from the world seed and the tick, so the same seed gives the same wind. Placeholder.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "extremes": {
          "description": "Rough days of this climate (A1382, spec R24, review GW1 #23950): extreme weather entered by the weather's own daily roll (stream weather/extreme), never set from outside. Omitted = none.",
          "$ref": "#/$defs/ClimateExtremes"
        }
      }
    },
    "ClimateSignal": {
      "description": "One tracked weather condition: the core reports start_event when it begins and end_event when it ends (ids of the vocabulary 'event').",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "start_event",
        "end_event"
      ],
      "properties": {
        "condition": {
          "description": "Weather id (one of the states of this climate).",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "start_event": {
          "description": "Event id reported when the condition begins.",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "end_event": {
          "description": "Event id reported when the condition ends.",
          "$ref": "common.schema.json#/$defs/VocabId"
        }
      }
    },
    "ClimateWeatherState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "wind_permille",
        "gust_permille",
        "precipitation_permille",
        "cloud_permille"
      ],
      "properties": {
        "weather": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "wind_permille": {
          "description": "Base wind strength of this weather (sound and nature motion read the wind with its gusts, IWeather.WindAt).",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "gust_permille": {
          "description": "How far the slow gusts swing the wind around wind_permille, up and down (the result stays within 0..1000). Placeholder.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "precipitation_permille": {
          "description": "Rain or snow strength.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "cloud_permille": {
          "description": "Cloud cover.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sight_permille": {
          "description": "How far the inhabitants see in this weather, in permille of their sight range (B2594): the core scales the exploration range (cells) and the perception radius (metres) with it; of several conditions at once the lowest counts. Absent = 1000 (full sight). Placeholder.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "ClimateSeasonWeather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "transitions"
      ],
      "properties": {
        "season": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "transitions": {
          "description": "One entry per weather the season can be in.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ClimateTransition"
          },
          "maxItems": 32
        }
      }
    },
    "ClimateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_weather",
        "to"
      ],
      "properties": {
        "from_weather": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "to": {
          "description": "Next weather with relative weights.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ClimateTransitionTarget"
          },
          "maxItems": 32
        }
      }
    },
    "ClimateTransitionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "weight"
      ],
      "properties": {
        "weather": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "weight": {
          "description": "Relative weight.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "ClimateTemperature": {
      "description": "Air temperature in tenths of a degree (B2 R13, B5 R1/R28): base value of the climate plus an offset for the season, the weather and the time of day; the preset's height drop applies on top. Every season, weather state and time of day needs an entry (load check). Optional: an hourly curve per season replaces the time-of-day offset for that season, biome offsets add per cell, and a season transition blends the season's part in linearly. Without the optional fields the temperature is exactly as before.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_tenth_c",
        "seasons",
        "weathers",
        "times_of_day"
      ],
      "properties": {
        "base_tenth_c": {
          "type": "integer",
          "minimum": -600,
          "maximum": 600
        },
        "seasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "description": "Offset per season.",
          "items": {
            "$ref": "#/$defs/TemperatureSeasonOffset"
          }
        },
        "weathers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "description": "Offset per weather state.",
          "items": {
            "$ref": "#/$defs/TemperatureWeatherOffset"
          }
        },
        "times_of_day": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "description": "Offset per time of day (dawn, day, dusk, night).",
          "items": {
            "$ref": "#/$defs/TemperatureTimeOffset"
          }
        },
        "hourly": {
          "description": "Optional daily curve per season (B5 R28): points by hour, interpolated linearly by the minute and around midnight. A season with a curve uses it instead of times_of_day. At most one curve per season (load check).",
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/TemperatureHourlyCurve"
          }
        },
        "biomes": {
          "description": "Optional offsets per biome (B5 R28), for one season or, without season, for all; matching entries add up. A pair of biome and season appears at most once (load check).",
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/TemperatureBiomeOffset"
          }
        },
        "season_transition_hours": {
          "description": "Optional: during the first hours of a season its part (season offset, daily curve or time-of-day offset, biome offsets) blends linearly from the previous season's part (B5 R1). 0 or absent = a hard change at the boundary.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "TemperatureSeasonOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "offset_tenth_c"
      ],
      "properties": {
        "season": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "offset_tenth_c": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "TemperatureWeatherOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "offset_tenth_c"
      ],
      "properties": {
        "weather": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "offset_tenth_c": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "TemperatureTimeOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_of_day",
        "offset_tenth_c"
      ],
      "properties": {
        "time_of_day": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "offset_tenth_c": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "TemperatureHourlyCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "points"
      ],
      "properties": {
        "season": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "points": {
          "description": "Points of the curve; hours strictly ascending and below the hours of a day (load check).",
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": {
            "$ref": "#/$defs/TemperatureHourPoint"
          }
        }
      }
    },
    "TemperatureHourPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hour",
        "offset_tenth_c"
      ],
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 47
        },
        "offset_tenth_c": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "TemperatureBiomeOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biome",
        "offset_tenth_c"
      ],
      "properties": {
        "biome": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "season": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "offset_tenth_c": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "ClimateExtremes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cooldown_days",
        "weather",
        "heat_waves"
      ],
      "properties": {
        "cooldown_days": {
          "description": "Whole days after an extreme ends before the next may begin (calm world).",
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "weather": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ClimateExtremeWeather"
          }
        },
        "heat_waves": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/ClimateHeatWave"
          }
        }
      }
    },
    "ClimateExtremeWeather": {
      "description": "A weather state held for a while (a storm, a long heavy rain): at the start of a day of the season it begins with chance_permille and lasts a whole number of hours between hours_min and hours_max; the usual weather changes rest meanwhile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "weather",
        "chance_permille",
        "hours_min",
        "hours_max"
      ],
      "properties": {
        "season": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "weather": {
          "description": "A weather state of this climate.",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "chance_permille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "hours_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "hours_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        }
      }
    },
    "ClimateHeatWave": {
      "description": "A heat wave: at the start of a day of the season it begins with chance_permille, lasts days_min to days_max whole days and lifts the air by offset_tenth_c over the climate's curve (what the inhabitants feel; the weather states go on).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "chance_permille",
        "days_min",
        "days_max",
        "offset_tenth_c"
      ],
      "properties": {
        "season": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "chance_permille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "days_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "days_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "offset_tenth_c": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    }
  }
}
