{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-appearance.schema.json",
  "title": "LookAppearance",
  "description": "Data file content/look/appearance.json: value ranges of the appearance record. The core draws it from the seed (stream inhabitant/<id>/appearance, B2503); inheritance follows in B9. Everyone is always dressed (B2472). Values are placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "height_cm",
    "build_permille",
    "skin_tones",
    "hair_styles",
    "hair_colors",
    "clothing_styles",
    "clothing_colors",
    "age_stages"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "height_cm": {
      "$ref": "#/$defs/AppearanceIntRange"
    },
    "build_permille": {
      "$ref": "#/$defs/AppearanceIntRange"
    },
    "skin_tones": {
      "description": "Skin tones to choose from.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "maxItems": 64
    },
    "hair_styles": {
      "description": "Hair style ids (model variants).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "hair_colors": {
      "description": "Hair colours.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "maxItems": 64
    },
    "clothing_styles": {
      "description": "Clothing ids (model variants); every style covers the body.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "clothing_colors": {
      "description": "Clothing colours.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "maxItems": 64
    },
    "age_stages": {
      "description": "Age stages from baby to old age, ascending from_age_days.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AppearanceAgeStage"
      },
      "maxItems": 16
    }
  },
  "$defs": {
    "AppearanceIntRange": {
      "description": "Range (min <= max).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "description": "Smallest value.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max": {
          "description": "Largest value.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "AppearanceAgeStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_age_days",
        "scale"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "from_age_days": {
          "description": "Age in game days from which this stage applies.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "scale": {
          "description": "Body scale relative to an adult.",
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.5
        }
      }
    }
  }
}
