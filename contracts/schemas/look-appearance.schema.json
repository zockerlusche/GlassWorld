{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/look-appearance.schema.json",
  "title": "LookAppearance",
  "description": "Data file content/look/appearance.json: value ranges of the appearance record. The core draws it from the seed (stream inhabitant/<id>/appearance, B2503); inheritance follows in B9. Everyone is always dressed (B2472). Values are placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "height_cm",
    "build_permille",
    "skin_tones",
    "hair_styles",
    "hair_colors",
    "outfits",
    "clothing_colors",
    "age_stages",
    "shapes",
    "head_scale",
    "elder_hair_colors",
    "start_age_days",
    "shape_chance_permille",
    "sex_shapes"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "height_cm": {
      "$ref": "#/$defs/AppearanceIntRange"
    },
    "build_permille": {
      "$ref": "#/$defs/AppearanceIntRange"
    },
    "skin_tones": {
      "description": "Skin tones to choose from.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "maxItems": 64
    },
    "hair_styles": {
      "description": "Hair styles drawn from the seed by weight (F4 hair kit); ids match the figure hair meshes (figures.json), bald has none.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/AppearanceHairStyle"
      }
    },
    "hair_colors": {
      "description": "Hair colours.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "maxItems": 64
    },
    "clothing_colors": {
      "description": "Clothing colours.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "maxItems": 64
    },
    "age_stages": {
      "description": "Age stages from baby to old age, ascending from_age_days.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AppearanceAgeStage"
      },
      "maxItems": 16
    },
    "shapes": {
      "description": "Body shape blend weights drawn per inhabitant from the seed (B2528); several shapes combine. Ids match the blend shapes of the figure models (body_<id>).",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/AppearanceShapeRange"
      }
    },
    "head_scale": {
      "$ref": "#/$defs/AppearanceNumberRange"
    },
    "elder_hair_colors": {
      "description": "Hair colours of elders (grey and white).",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "description": "Colour as lowercase #rrggbb.",
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      }
    },
    "start_age_days": {
      "description": "Age in days of the start inhabitants; the age stage follows from age_stages (ageing comes with B9).",
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "shape_chance_permille": {
      "description": "Chance that an inhabitant gets one body shape from shapes (in the shape's range).",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "outfits": {
      "description": "Outfits (sets of clothing parts, F4) the start inhabitants are drawn from by weight among those whose conditions fit the place and time; everyone is always dressed (B2472). At least one outfit has no conditions, so there is always one. Values are placeholders.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/AppearanceOutfit"
      }
    },
    "sex_shapes": {
      "description": "Sex proportions as blend shape weights (F4: bust, waist, hips, shoulders), drawn for every entry in file order and kept for the inhabitant's sex and age stage; ids match the blend shapes of the figure models (body_<id>). Subtle and age-appropriate (B2466).",
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/AppearanceSexShape"
      }
    },
    "renamed_hair_styles": {
      "description": "Hair style ids that were renamed (F4): saves and records with the old id get the new one on load, so older worlds keep their figures.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/AppearanceRename"
      }
    },
    "renamed_outfits": {
      "description": "Outfit ids that were renamed or dropped (F4), each with the outfit that replaces it: saves and records with the old id get the new one on load.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/AppearanceRename"
      }
    }
  },
  "$defs": {
    "AppearanceIntRange": {
      "description": "Range (min <= max).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "description": "Smallest value.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max": {
          "description": "Largest value.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "AppearanceAgeStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_age_days",
        "scale"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "from_age_days": {
          "description": "Age in game days from which this stage applies.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "scale": {
          "description": "Body scale relative to an adult.",
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.5
        }
      }
    },
    "AppearanceShapeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "min",
        "max"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "min": {
          "description": "Smallest weight.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "description": "Largest weight.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "AppearanceNumberRange": {
      "description": "Range (min <= max).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "description": "Smallest value.",
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        },
        "max": {
          "description": "Largest value.",
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        }
      }
    },
    "AppearanceHairStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "length_rank"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "weight": {
          "description": "Relative chance (placeholder).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "length_rank": {
          "description": "How long the hair is, 0 (bald) .. 10; a hook for hair that grows later (no logic yet).",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "AppearanceOutfit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parts",
        "weight"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "parts": {
          "description": "Clothing parts worn together (figures.json clothing_parts).",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "weight": {
          "description": "Relative chance among the fitting outfits (placeholder).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "when": {
          "$ref": "#/$defs/AppearanceOutfitCondition"
        }
      }
    },
    "AppearanceOutfitCondition": {
      "description": "Where and when an outfit fits; a missing list means any. All given lists must match.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seasons": {
          "description": "Seasons (content/world/time.json).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "climates": {
          "description": "Climates (content/climate file ids).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "biomes": {
          "description": "Biomes at the inhabitant's place (vocabulary biome).",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "tech_levels": {
          "description": "Tech levels of the world (vocabulary tech_level).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "sexes": {
          "description": "Sexes who wear it (placeholder until Marcel's picture question).",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(female|male)$"
          }
        }
      }
    },
    "AppearanceSexShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sex",
        "id",
        "min",
        "max",
        "age_stages"
      ],
      "properties": {
        "sex": {
          "description": "Sex this proportion belongs to.",
          "type": "string",
          "enum": [
            "female",
            "male"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "min": {
          "description": "Smallest weight.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "description": "Largest weight.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "age_stages": {
          "description": "Age stages that show it (none for babies and children).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        }
      }
    },
    "AppearanceRename": {
      "description": "An old id and the current id that replaces it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_id",
        "new_id"
      ],
      "properties": {
        "old_id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "new_id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        }
      }
    }
  }
}
