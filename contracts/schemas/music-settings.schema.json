{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/music-settings.schema.json",
  "title": "MusicSettings",
  "description": "Calm generative background music (B8 R6, B2466): moods (key, scale, tempo, instrument colours) and rules that pick a mood by time of day, season and epoch; soft transitions and pauses between pieces. The limits of this schema keep it calm: only soft waves, slow tempo, long notes, gentle onsets, no alarm tones. Values are placeholders until Marcel's word.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sample_rate",
    "peak",
    "fade_s",
    "min_mood_s",
    "piece_s",
    "pause_s",
    "moods",
    "rules",
    "loudness_dbfs"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "sample_rate": {
      "type": "integer",
      "enum": [
        22050,
        44100,
        48000
      ]
    },
    "peak": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.8
    },
    "fade_s": {
      "description": "Cross-fade between pieces of different moods (spec 33: 8-15 s).",
      "type": "number",
      "minimum": 8,
      "maximum": 15
    },
    "min_mood_s": {
      "description": "A mood plays at least this long in real seconds before the next change (at least fade_s, checked on load): at fast forward a short twilight does not cut a piece off (review #92).",
      "type": "number",
      "minimum": 8,
      "maximum": 600
    },
    "piece_s": {
      "$ref": "#/$defs/MusicRange"
    },
    "pause_s": {
      "description": "Silence between two pieces of the same mood (silence is part of the calm world).",
      "$ref": "#/$defs/MusicRange"
    },
    "moods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/MusicMood"
      }
    },
    "rules": {
      "description": "Checked in order; the first rule whose lists all contain the current value (an empty list matches all) picks the mood. The last rule should match everything.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/MusicRule"
      }
    },
    "loudness_dbfs": {
      "description": "Gated RMS loudness the sound is normalised to: the same target as every other sound (Marcel W1645); peak stays the upper limit.",
      "type": "number",
      "minimum": -40,
      "maximum": -6
    }
  },
  "$defs": {
    "MusicRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "max": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "MusicMood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root_hz",
        "scale",
        "tempo_bpm",
        "note_beats",
        "rest_chance",
        "melody",
        "pad"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "root_hz": {
          "type": "number",
          "minimum": 80,
          "maximum": 440
        },
        "scale": {
          "description": "Semitone steps above the root the melody may use (at most one octave: with root and octave limits no melody note goes above about 1.8 kHz).",
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        },
        "tempo_bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 90
        },
        "note_beats": {
          "description": "Note lengths in beats a melody note may take (no hurried notes).",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 8
          }
        },
        "rest_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "melody": {
          "$ref": "#/$defs/MusicVoice"
        },
        "pad": {
          "$ref": "#/$defs/MusicPad"
        }
      }
    },
    "MusicVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "octave",
        "gain",
        "attack_s",
        "release_s"
      ],
      "properties": {
        "wave": {
          "description": "Only soft waves (no square or saw: those sound like alarms).",
          "type": "string",
          "enum": [
            "sine",
            "triangle"
          ]
        },
        "octave": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attack_s": {
          "description": "Gentle onsets only.",
          "type": "number",
          "minimum": 0.04,
          "maximum": 4
        },
        "release_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6
        }
      }
    },
    "MusicPad": {
      "description": "A soft held chord under the melody, changing every few bars.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "gain",
        "chord",
        "bars",
        "attack_s",
        "release_s"
      ],
      "properties": {
        "wave": {
          "type": "string",
          "enum": [
            "sine",
            "triangle"
          ]
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "chord": {
          "description": "Semitone steps above the chord's root.",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        },
        "bars": {
          "description": "Bars (4 beats) a chord is held.",
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "attack_s": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 8
        },
        "release_s": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 8
        }
      }
    },
    "MusicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mood",
        "times_of_day",
        "seasons",
        "epochs"
      ],
      "properties": {
        "mood": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "times_of_day": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "seasons": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "epochs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        }
      }
    }
  }
}
