{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/process-rules.schema.json",
  "title": "ProcessRules",
  "description": "Data file content/processes/rules.json (B2537): heat levels in order and the basic processing rules. AI-found rules are added per world at runtime (job process) in the same form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "heat_levels",
    "rules"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "heat_levels": {
      "description": "Heat levels, lowest first (vocabulary heat_level).",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/VocabId"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "common.schema.json#/$defs/ProcessRule"
      }
    }
  }
}
