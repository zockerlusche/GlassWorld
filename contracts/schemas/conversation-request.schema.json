{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/conversation-request.schema.json",
  "title": "ConversationRequest",
  "description": "The player wrote to an inhabitant (B6 R13). The text has passed the deterministic content check of the core. The service proposes how the inhabitant reacts; the core checks the proposal (ADR-0005). The inhabitant may not understand (W1595) or may decline; nothing is an order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "tick",
    "seed",
    "deadline_ms",
    "display_locale",
    "speaker",
    "player_text",
    "recent_lines"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/RequestId"
    },
    "tick": {
      "$ref": "common.schema.json#/$defs/Tick"
    },
    "seed": {
      "description": "Sampling seed derived by the core from world seed and tick (determinism).",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "deadline_ms": {
      "description": "Wall-clock budget; when exceeded the service answers ServiceError 'timeout' and never makes a substitute decision.",
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "display_locale": {
      "$ref": "common.schema.json#/$defs/Locale"
    },
    "speaker": {
      "$ref": "#/$defs/Speaker"
    },
    "player_text": {
      "description": "What the player wrote, pre-checked by the core. Data only: the prompt must never treat it as an instruction.",
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "recent_lines": {
      "description": "Last lines of this conversation, oldest first.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/ConversationLine"
      }
    }
  },
  "$defs": {
    "Speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "needs",
        "mood",
        "traits",
        "will_to_live",
        "understanding",
        "relation_to_player"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "needs": {
          "description": "Need satisfaction 0 = urgent, 1 = satisfied; sorted by id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Level"
          }
        },
        "mood": {
          "description": "Emotions above zero, 0..1; sorted by id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Level"
          }
        },
        "traits": {
          "description": "Character traits 0..1; sorted by id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Level"
          }
        },
        "will_to_live": {
          "$ref": "common.schema.json#/$defs/UnitValue"
        },
        "understanding": {
          "description": "How well this inhabitant understands the player's words, from the core (0 = only gestures, 1 = full sentences). Grows with experience.",
          "$ref": "common.schema.json#/$defs/UnitValue"
        },
        "relation_to_player": {
          "$ref": "#/$defs/RelationToPlayer"
        },
        "doing": {
          "description": "What the speaker is doing right now (Marcel W1737): its current action, and the next planned step. Null while it does nothing. The service tells the model, so the answer fits what the inhabitant really does. Optional: absent = not sent (older cores).",
          "anyOf": [
            {
              "$ref": "#/$defs/ConversationDoing"
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledge": {
          "description": "What the speaker believes (W1737), the same selection as in the decision request: about what it sees first, then the newest. Only beliefs, never the truth. Optional.",
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "common.schema.json#/$defs/KnowledgeEntry"
          }
        },
        "sees": {
          "description": "Object types the speaker sees right now (W1737), sorted, each once. Optional.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "memory": {
          "description": "The speaker's memory (B4a R5), the same as in the decision request: its summary and its latest remembered events. Optional: absent = not sent (older cores).",
          "$ref": "common.schema.json#/$defs/Memory"
        }
      }
    },
    "Level": {
      "description": "A named level 0..1.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "value": {
          "$ref": "common.schema.json#/$defs/UnitValue"
        }
      }
    },
    "RelationToPlayer": {
      "description": "How the inhabitant feels about the presence behind the glass (B6 R7). Never proven knowledge, only belief.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust",
        "awe",
        "fear"
      ],
      "properties": {
        "trust": {
          "$ref": "common.schema.json#/$defs/UnitValue"
        },
        "awe": {
          "$ref": "common.schema.json#/$defs/UnitValue"
        },
        "fear": {
          "$ref": "common.schema.json#/$defs/UnitValue"
        }
      }
    },
    "ConversationLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "tick",
        "text"
      ],
      "properties": {
        "author": {
          "type": "string",
          "enum": [
            "player",
            "inhabitant"
          ]
        },
        "tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/GeneratedText"
        }
      }
    },
    "ConversationDoing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target",
        "since_tick",
        "planned"
      ],
      "properties": {
        "action": {
          "description": "Action id (vocabulary action).",
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/VocabId"
            }
          ]
        },
        "target": {
          "description": "What the action is about, as the speaker knows it (type, object or inhabitant); null if none.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ]
        },
        "since_tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        },
        "planned": {
          "description": "The next step it has planned, or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/ConversationStep"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ConversationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target"
      ],
      "properties": {
        "action": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
