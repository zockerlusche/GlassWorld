{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/animation-library.schema.json",
  "title": "AnimationLibrary",
  "description": "Data file content/animation/library.json: every action and expression of the vocabulary, the idle behaviour, gaits and special moves mapped to a clip (B2 R27-R29). Unknown ids get the fallback clip and a log entry. Idle weights depend on core values (needs and moods 0..1); the choice is deterministic from inhabitant id and tick and not part of the hash (B2514 T4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "fallback_clip",
    "clips",
    "mappings",
    "gaits",
    "idle"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "fallback_clip": {
      "$ref": "common.schema.json#/$defs/VocabId"
    },
    "clips": {
      "description": "Clips and how they are made.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AnimationClip"
      },
      "maxItems": 512
    },
    "mappings": {
      "description": "Vocabulary or library id to clip.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AnimationMapping"
      },
      "maxItems": 1024
    },
    "gaits": {
      "description": "Gaits by speed, ascending; the gait blends steplessly.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AnimationGait"
      },
      "maxItems": 16
    },
    "idle": {
      "description": "Idle behaviour between tasks (presentation only).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AnimationIdle"
      },
      "maxItems": 64
    }
  },
  "$defs": {
    "AnimationClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "loop"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "source": {
          "description": "asset: a clip from a CC0 GLB; blend: mix of other clips; procedural: LookAt/IK in code; placeholder: not yet made.",
          "type": "string",
          "enum": [
            "asset",
            "blend",
            "procedural",
            "placeholder"
          ]
        },
        "loop": {
          "description": "Whether the clip loops.",
          "type": "boolean"
        }
      }
    },
    "AnimationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "clip"
      ],
      "properties": {
        "kind": {
          "description": "What the id names.",
          "type": "string",
          "enum": [
            "action",
            "expression",
            "work",
            "special"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "clip": {
          "$ref": "common.schema.json#/$defs/VocabId"
        }
      }
    },
    "AnimationGait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clip",
        "min_speed_cm_s"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "clip": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "min_speed_cm_s": {
          "description": "Speed from which this gait applies.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "AnimationIdle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clip",
        "weight",
        "factors"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "clip": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "weight": {
          "description": "Base weight.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "factors": {
          "description": "Weight changes by core values.",
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/AnimationIdleFactor"
          },
          "maxItems": 8
        }
      }
    },
    "AnimationIdleFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "when",
        "weight"
      ],
      "properties": {
        "value": {
          "description": "A need, mood or trait id (values 0..1; for needs 1 = fully satisfied).",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "when": {
          "description": "low: weight grows as the value falls; high: as it rises.",
          "type": "string",
          "enum": [
            "low",
            "high"
          ]
        },
        "weight": {
          "description": "Extra weight at the extreme.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
