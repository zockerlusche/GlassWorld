{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/image-generation.schema.json",
  "title": "ImageGeneration",
  "description": "How the local image model makes pictures in the computing night (B7 R5/R7, TL #18681): the workflow per hardware tier (null = no image AI on this tier, the capability flag), picture sizes per purpose and the job priority. Values are placeholders until Marcel decides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "by_tier",
    "sizes",
    "priority"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "by_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "standard",
        "comfort"
      ],
      "properties": {
        "minimum": {
          "description": "null = no image AI on this tier (capability flag).",
          "anyOf": [
            {
              "$ref": "#/$defs/TierWorkflow"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard": {
          "description": "null = no image AI on this tier (capability flag).",
          "anyOf": [
            {
              "$ref": "#/$defs/TierWorkflow"
            },
            {
              "type": "null"
            }
          ]
        },
        "comfort": {
          "description": "null = no image AI on this tier (capability flag).",
          "anyOf": [
            {
              "$ref": "#/$defs/TierWorkflow"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sizes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icon",
        "texture"
      ],
      "properties": {
        "icon": {
          "$ref": "#/$defs/Size"
        },
        "texture": {
          "$ref": "#/$defs/Size"
        }
      }
    },
    "priority": {
      "description": "Job priority of image jobs (B7 O2); when they run is in content/hardware/night.json.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "invention_icons": {
      "description": "A1564 (B4b/B7 R7): the core asks for an icon of every new invention (purpose icon, size from sizes.icon), painted in the computing night. A retryable failure is tried again in the next night up to max_attempts; after that the thing keeps the colours of the construction kit. Omitted = no picture jobs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "max_attempts"],
      "properties": {
        "style": { "description": "Style id of the image prompt (settings.styles, e.g. warm_comic, B2501).", "$ref": "common.schema.json#/$defs/VocabId" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    }
  },
  "$defs": {
    "TierWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "model",
        "prompt",
        "prompt_version",
        "reference_image"
      ],
      "properties": {
        "workflow": {
          "description": "Template name in tools/comfyui/workflows (without .api.json).",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "model": {
          "description": "Model id of the workflow in content/hardware/models.json (residency, provenance).",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "description": "Prompt name in prompts/ (e.g. image/object).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_-]*$",
          "maxLength": 64
        },
        "prompt_version": {
          "type": "integer",
          "minimum": 1
        },
        "reference_image": {
          "description": "Style reference for edit workflows, relative to content/ (e.g. D355), else null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*\\.png$",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Workflow, prompt and optional style reference of a tier."
    },
    "Size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 2048
        }
      }
    }
  }
}
