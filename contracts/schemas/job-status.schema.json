{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/job-status.schema.json",
  "title": "JobStatus",
  "description": "AI service -> core (GET /jobs/{id}): state of one job. The service guarantees: done -> result and provenance set, error null; failed -> error set, result and provenance null; open states -> all three null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "job_id",
    "tick",
    "kind",
    "state",
    "result",
    "error",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/RequestId"
    },
    "tick": {
      "description": "Echo of the job tick.",
      "$ref": "common.schema.json#/$defs/Tick"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/JobKind"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/JobState"
    },
    "result": {
      "description": "Set when state is done.",
      "anyOf": [
        {
          "$ref": "#/$defs/JobResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "description": "Set when state is failed.",
      "anyOf": [
        {
          "$ref": "#/$defs/JobError"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "description": "Set when state is done (B7 R1: model, prompt version, seed).",
      "anyOf": [
        {
          "$ref": "#/$defs/JobProvenance"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "JobResult": {
      "description": "One optional field per job kind; exactly the field named like the kind is set (checked by the service and the core). Unset fields are left out by both type systems (pydantic exclude_unset, C# WhenWritingNull), so a new kind is not a breaking change (review GW1 M1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "$ref": "#/$defs/QuestionResult"
        },
        "invention": {
          "$ref": "#/$defs/InventionResult"
        },
        "build_plan": {
          "$ref": "#/$defs/BuildPlan"
        },
        "process": {
          "$ref": "#/$defs/ProcessResult"
        },
        "memory": {
          "$ref": "#/$defs/MemoryResult"
        },
        "sound": {
          "$ref": "#/$defs/SoundResult"
        }
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "QuestionResult": {
      "description": "A GUESS coloured by character, never the truth (ADR-0005). The core stores it as knowledge with source guessed; trying it out shows the truth.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "understood",
        "guesses",
        "idea",
        "thought",
        "rationale"
      ],
      "properties": {
        "understood": {
          "description": "false = the inhabitant does not understand it (allowed, W1595); guesses may then be empty.",
          "type": "boolean"
        },
        "guesses": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Guess"
          }
        },
        "idea": {
          "description": "Optional idea what to do (action id from the vocabulary); a proposal, the core decides.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/VocabId"
            },
            {
              "type": "null"
            }
          ]
        },
        "thought": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Thought"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "Guess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "value",
        "confidence"
      ],
      "properties": {
        "property": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "value": {
          "type": "boolean"
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/UnitValue"
        }
      }
    },
    "JobError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/ServiceErrorCode"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "description": "true = the core may try again with a NEW request_id (new attempt); false = give up (e.g. kind not supported).",
          "type": "boolean"
        }
      }
    },
    "JobProvenance": {
      "description": "Where the result came from, for logs and replays.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "model",
        "prompt_version",
        "seed",
        "latency_ms",
        "attempts"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "ollama",
            "comfyui",
            "mock",
            "replay",
            "local_model"
          ],
          "description": "ollama = language model, comfyui = image model, local_model = other local models run in-process (e.g. MOSS sound, B8), mock/replay = tests."
        },
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "format": "int64"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "GuardVerdict": {
      "description": "One verdict of the AI rule guard (own instruction, ADR-0005). The core checks again and has the last word.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "decision",
        "reasons",
        "note"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "downsize",
            "revise",
            "reject"
          ]
        },
        "reasons": {
          "description": "Reason codes from data (content/guard).",
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "note": {
          "description": "Short English note for the log, never shown.",
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "SoundDecision": {
      "description": "B2530: does the thing make a sound, and which (GW3 #19017). The core checks format and length only (D471 O3).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needed",
        "description",
        "kind",
        "part"
      ],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "description": {
          "description": "Short English sound description for the sound model, e.g. 'wooden door creaks'.",
          "type": "string",
          "maxLength": 120
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/SoundKind"
        },
        "part": {
          "description": "Part that sounds (vocabulary), or null.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/VocabId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InventionResult": {
      "description": "Result of the invention job: the (possibly downsized) invention after at most max_rounds guard rounds, or null when rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "invention",
        "rounds",
        "sound",
        "thought"
      ],
      "properties": {
        "decision": {
          "description": "Final AI verdict.",
          "type": "string",
          "enum": [
            "approve",
            "downsize",
            "reject"
          ]
        },
        "invention": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Invention"
            },
            {
              "type": "null"
            }
          ]
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/GuardVerdict"
          }
        },
        "sound": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "thought": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Thought"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BuildPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "size_m",
        "position_m",
        "rotation_y_deg",
        "material",
        "color",
        "step"
      ],
      "properties": {
        "shape": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "size_m": {
          "description": "Size of the part in metres.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0.005
            },
            "y": {
              "type": "number",
              "minimum": 0.005
            },
            "z": {
              "type": "number",
              "minimum": 0.005
            }
          }
        },
        "position_m": {
          "description": "Centre relative to the object origin, metres.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "rotation_y_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "material": {
          "description": "One of Invention.materials (core checks).",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "color": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "step": {
          "description": "Building step that adds the part (1-based).",
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "BuildPlan": {
      "description": "The shape of an invention: construction-kit parts with size, place, material and colour (ADR-0004). The core checks it; Godot builds it part by part.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/BuildPart"
          }
        }
      }
    },
    "ProcessResult": {
      "description": "Judgement of an unknown try (B2537): feasible with exactly one rule, or not feasible (also stored, never asked again).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feasible",
        "rule",
        "rationale"
      ],
      "properties": {
        "feasible": {
          "type": "boolean"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ProcessRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "MemoryResult": {
      "description": "The new summary (English, internal) and the ticks of the formative events it keeps (all of them; checked by the service).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "kept"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "kept": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Tick"
          }
        }
      }
    },
    "SoundResult": {
      "description": "A made sound (D471 D7): a WAV the service wrote into its output folder under a name by pattern; the game copies it into the world folder. Checked by the service (length, level, silence) before it reports done.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "seconds",
        "seed_used",
        "attempts",
        "peak_dbfs",
        "loudness_dbfs"
      ],
      "properties": {
        "file": {
          "description": "File name in the service's output folder (no path).",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*\\.wav$",
          "maxLength": 120
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "seed_used": {
          "description": "Seed of the accepted try ((job seed + retries) mod 2^31), so the sound can be made again.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "attempts": {
          "description": "Tries until one passed the check (1 + seed retries).",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "peak_dbfs": {
          "type": "number",
          "minimum": -120,
          "maximum": 0
        },
        "loudness_dbfs": {
          "description": "Gated RMS loudness as measured by the service.",
          "type": "number",
          "minimum": -120,
          "maximum": 0
        }
      }
    }
  }
}
