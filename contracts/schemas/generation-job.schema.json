{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/generation-job.schema.json",
  "title": "GenerationJob",
  "description": "Core -> AI service (POST /jobs): one generation job (B7 R1). The service keeps jobs only in memory; the core owns open jobs. request_id is the job id. Sending the SAME job again (same id, same content) is harmless and returns the existing job, e.g. after a lost answer. A NEW attempt (after a failed job, or after the service restarted and answers not_found) always gets a NEW request_id, like Resend for decisions. Same id with different content is rejected (bad_request, not retryable).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "tick",
    "seed",
    "display_locale",
    "kind",
    "priority",
    "inhabitant",
    "object",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "request_id": {
      "description": "Deterministic id from the core; also the job id. New attempt = new id.",
      "$ref": "common.schema.json#/$defs/RequestId"
    },
    "tick": {
      "description": "Tick at which the core created the job.",
      "$ref": "common.schema.json#/$defs/Tick"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "display_locale": {
      "$ref": "common.schema.json#/$defs/Locale"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/JobKind"
    },
    "priority": {
      "description": "Higher runs first; ties in order of arrival. Values come from data in the core (B7 O2).",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "inhabitant": {
      "description": "Inhabitant the job is about, if any.",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "object": {
      "description": "Object the job is about, if any.",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "$ref": "#/$defs/JobPayload"
    }
  },
  "$defs": {
    "JobPayload": {
      "description": "One optional field per job kind; exactly the field named like the kind is set (checked by the service and the core). Unset fields are left out by both type systems (pydantic exclude_unset, C# WhenWritingNull), so a new kind is not a breaking change (review GW1 M1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "$ref": "#/$defs/QuestionPayload"
        },
        "invention": {
          "$ref": "#/$defs/InventionPayload"
        },
        "build_plan": {
          "$ref": "#/$defs/BuildPlanPayload"
        },
        "process": {
          "$ref": "#/$defs/ProcessPayload"
        }
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "QuestionPayload": {
      "description": "An inhabitant does not understand something and asks (W1595). No deadline (B2487): answered at once on strong PCs, at the latest in the computing night.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "subject",
        "inhabitant",
        "perception"
      ],
      "properties": {
        "question": {
          "description": "what_is = what is this; can_i_eat; is_dangerous; what_can_i_do = what can I do with it; why = why did this happen.",
          "type": "string",
          "enum": [
            "what_is",
            "can_i_eat",
            "is_dangerous",
            "what_can_i_do",
            "why"
          ]
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/Subject"
        },
        "inhabitant": {
          "$ref": "common.schema.json#/$defs/InhabitantState"
        },
        "perception": {
          "description": "What the inhabitant notices about the subject right now (observable properties only, no truth).",
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        }
      }
    },
    "InventionLimits": {
      "description": "Limits from data (B4b; values from Marcel, placeholders until then).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_size_m",
        "max_parts",
        "max_rounds"
      ],
      "properties": {
        "max_size_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "max_parts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "max_rounds": {
          "description": "Discussion rounds with the rule guard (B4b: 2).",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "InventionPayload": {
      "description": "Invent something (D471 stage 2): the inhabitant wants or found something it has no solution for.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "want",
        "subject",
        "inhabitant",
        "materials",
        "tech_level",
        "limits"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "need",
            "found",
            "idea"
          ]
        },
        "want": {
          "description": "Need or action the inhabitant has no solution for (vocabulary need or action).",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "subject": {
          "description": "Thing that was found, if the trigger is find.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ]
        },
        "inhabitant": {
          "$ref": "common.schema.json#/$defs/InhabitantState"
        },
        "materials": {
          "description": "Things in reach as the inhabitant sees them.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/ObservedThing"
          }
        },
        "tech_level": {
          "description": "Highest tech level the world allows now.",
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "limits": {
          "$ref": "#/$defs/InventionLimits"
        }
      }
    },
    "BuildPlanPayload": {
      "description": "Turn an approved invention into a building plan of construction-kit parts (D471 stage 4, ADR-0004).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invention",
        "shapes",
        "colors",
        "max_parts"
      ],
      "properties": {
        "invention": {
          "$ref": "common.schema.json#/$defs/Invention"
        },
        "shapes": {
          "description": "Part shapes of the construction kit (data).",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "colors": {
          "description": "Palette colours allowed (look data).",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "max_parts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        }
      }
    },
    "ProcessPayload": {
      "description": "An unknown try (B2537): no rule fits these inputs yet. Judged once; the result becomes a world rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "inputs",
        "tool",
        "heat_level",
        "tech_level",
        "inhabitant"
      ],
      "properties": {
        "process": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "common.schema.json#/$defs/ObservedThing"
          }
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ObservedThing"
            },
            {
              "type": "null"
            }
          ]
        },
        "heat_level": {
          "description": "Heat available, or null.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/VocabId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tech_level": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "inhabitant": {
          "$ref": "common.schema.json#/$defs/InhabitantState"
        }
      }
    }
  }
}
