{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworld.local/contracts/v0/sound-map.schema.json",
  "title": "SoundMap",
  "description": "Which sound plays for what (B8 R2): actions, surfaces under the feet, weather, biome ambience and animals by biome, season and time of day (B2481). Sound is presentation only and never changes the simulation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "actions",
    "surfaces",
    "weather",
    "ambience",
    "animals"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/ContractVersion"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SoundForAction"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SoundForSurface"
      }
    },
    "weather": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SoundForWeather"
      }
    },
    "ambience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SoundForBiome"
      }
    },
    "animals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SoundForAnimal"
      }
    },
    "signals": {
      "description": "Sounds of the world's signals to the player, heard at the glass rather than at a place in the world (B8 R17, B2608): an inhabitant knocking at the glass. Omitted = no signal sounds.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SoundForSignal"
      }
    }
  },
  "$defs": {
    "SoundForAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "sound"
      ],
      "properties": {
        "action": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "sound": {
          "description": "Language-neutral sound id, e.g. step.grass; null = silent on purpose (waiting and sleeping make no sound, Marcel W1643).",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "description": "Actions of one kind that share their sound on purpose carry the same group (B8 R2, B2608): e.g. moving for wander, explore, move_to, approach. Two actions with the same sound but no common group are a defect (Marcel W1741: one knock for combining, using and every building step).",
          "type": "string",
          "pattern": "^[a-z][a-z_]{1,31}$"
        }
      }
    },
    "SoundForSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "sound"
      ],
      "properties": {
        "signal": {
          "description": "The signal: knock = an inhabitant knocks at the glass (mail kind knock, B6 R10).",
          "type": "string",
          "enum": [
            "knock"
          ]
        },
        "sound": {
          "description": "Language-neutral sound id; null = silent on purpose.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SoundForSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "sound"
      ],
      "properties": {
        "surface": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "sound": {
          "description": "Language-neutral sound id, e.g. step.grass, animal.frog.call.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "maxLength": 64
        }
      }
    },
    "SoundForWeather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "sound"
      ],
      "properties": {
        "weather": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "sound": {
          "description": "Language-neutral sound id, e.g. step.grass, animal.frog.call.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "maxLength": 64
        }
      }
    },
    "SoundForBiome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biome",
        "sound"
      ],
      "properties": {
        "biome": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "sound": {
          "description": "Language-neutral sound id, e.g. step.grass, animal.frog.call.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "maxLength": 64
        }
      }
    },
    "SoundForAnimal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animal",
        "sound",
        "biomes",
        "seasons",
        "times_of_day",
        "per_hour"
      ],
      "properties": {
        "animal": {
          "$ref": "common.schema.json#/$defs/VocabId"
        },
        "sound": {
          "description": "Language-neutral sound id, e.g. step.grass, animal.frog.call.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "maxLength": 64
        },
        "biomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "seasons": {
          "description": "Seasons in which it can be heard (ids from content/world/time.json).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "times_of_day": {
          "description": "Phases from the time_of_day vocabulary.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/VocabId"
          }
        },
        "per_hour": {
          "description": "How often one animal near the camera calls per game hour; a fraction is the chance of one more call in that hour (0 = silent near the camera; heard only at the animal itself once animals are objects, B5).",
          "type": "number",
          "minimum": 0,
          "maximum": 600
        }
      }
    }
  }
}
