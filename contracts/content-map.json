{
  "contract_version": "0.1",
  "description": "Which schema validates which data file under content/. pattern is relative to content/; '*' matches within one folder only. Every .json file under content/ must match exactly one entry.",
  "entries": [
    {
      "pattern": "vocabulary/*.json",
      "schema": "vocabulary"
    },
    {
      "pattern": "world/time.json",
      "schema": "world-time-settings"
    },
    {
      "pattern": "objects/*.json",
      "schema": "object-types"
    },
    {
      "pattern": "rules/*.json",
      "schema": "combination-rules"
    },
    {
      "pattern": "i18n/*.json",
      "schema": "i18n"
    },
    {
      "pattern": "inhabitants/model.json",
      "schema": "inhabitant-model"
    },
    {
      "pattern": "effects/*.json",
      "schema": "action-effects"
    },
    {
      "pattern": "behaviour/utility.json",
      "schema": "utility-weights"
    },
    {
      "pattern": "decider/settings.json",
      "schema": "decider-settings"
    },
    {
      "pattern": "hardware/tiers.json",
      "schema": "hardware-tiers"
    },
    {
      "pattern": "world/placeholder-start.json",
      "schema": "placeholder-start"
    },
    {
      "pattern": "ui/tokens.json",
      "schema": "ui-tokens"
    },
    {
      "pattern": "ui/frames.json",
      "schema": "ui-frames"
    }
  ]
}
